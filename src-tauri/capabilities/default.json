{
    "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/v2.0/crates/tauri-config-schema/schema.json",
    "identifier": "default",
    "description": "Default permissions for AnhePlayer",
    "windows": ["main", "lyric", "minimode", "tray-menu"],
    "permissions": [
        "core:default",
        "core:window:allow-start-dragging",
        "core:window:allow-set-always-on-top",
        "core:window:allow-set-size",
        "core:window:allow-set-min-size",
        "core:window:allow-set-max-size",
        "opener:default",
        "http:default"
    ]
}
