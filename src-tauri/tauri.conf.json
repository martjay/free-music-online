{
    "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/v2.0/crates/tauri-config-schema/schema.json",
    "productName": "FreeMusicOnline",
    "mainBinaryName": "FreeMusicOnline",
    "version": "1.0.45",
    "identifier": "com.anhe.player",
    "build": {
        "beforeDevCommand": "pnpm dev:tauri-prepare",
        "devUrl": "http://localhost:47321",
        "beforeBuildCommand": "pnpm build:tauri-prepare",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": true,
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": ["**"]
            }
        },
        "windows": [
            {
                "label": "main",
                "title": "Free Music Online",
                "url": "/mainWindow.html",
                "width": 1100,
                "height": 690,
                "minWidth": 900,
                "minHeight": 600,
                "decorations": false,
                "transparent": false,
                "resizable": true,
                "dragDropEnabled": false,
                "center": true,
                "backgroundColor": "#121212"
            },
            {
                "label": "lyric",
                "title": "Free Music Lyric",
                "url": "/lyricWindow.html",
                "width": 800,
                "height": 160,
                "minWidth": 320,
                "minHeight": 80,
                "decorations": false,
                "transparent": true,
                "backgroundColor": "#00000000",
                "alwaysOnTop": true,
                "visible": false,
                "resizable": true,
                "maximizable": false,
                "minimizable": false,
                "closable": false,
                "skipTaskbar": true,
                "focus": false,
                "shadow": false,
                "noRedirectionBitmap": true
            },
            {
                "label": "minimode",
                "title": "Free Music Mini",
                "url": "/minimodeWindow.html",
                "width": 408,
                "height": 148,
                "minWidth": 320,
                "minHeight": 120,
                "decorations": false,
                "transparent": true,
                "backgroundColor": "#00000000",
                "shadow": false,
                "alwaysOnTop": true,
                "visible": false,
                "resizable": true,
                "maximizable": false,
                "skipTaskbar": false
            }
        ]
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "windows": {
            "nsis": {
                "template": "./windows/installer.nsi",
                "installerHooks": "./windows/hooks.nsh"
            }
        },
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    },
    "plugins": {
        "opener": {}
    }
}
